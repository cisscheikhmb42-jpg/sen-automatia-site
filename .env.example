# Copiez ce fichier en ".env.local" (en local) et renseignez les mêmes
# variables dans Vercel > Project > Settings > Environment Variables.
# Ne publiez JAMAIS le fichier .env.local.

# Adresse publique du site (sitemap, liens de partage)
NEXT_PUBLIC_SITE_URL=https://senautomatia.com

# Supabase (Project Settings > API). Utilisées uniquement côté serveur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Suivi publicitaire et statistiques : laisser vide pour désactiver.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
